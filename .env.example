# Goodbye to Blood Test — Phase 1 configuration
APP_NAME=Goodbye to Blood Test
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite (default local) OR PostgreSQL
# DATABASE_URL=sqlite:///./backend/fingerabo.db
# DATABASE_URL=postgresql+psycopg2://fingerabo:fingerabo@localhost:5432/fingerabo
DATABASE_URL=sqlite:///./backend/fingerabo.db

# Paths relative to project root unless absolute
PROJECT_ROOT=.
MODEL_REGISTRY_DIR=models/registry
ACTIVE_MODEL_ID=resnet50_v1
RESNET50_V1_PATH=test/model_blood_group_detection_resnet.h5
IMAGE_SIZE=256
MAX_UPLOAD_MB=10
STORE_PREDICTION_IMAGES=false
TEMP_DIR=storage/tmp
